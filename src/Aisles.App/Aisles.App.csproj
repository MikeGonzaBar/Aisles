<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Aisles.App</RootNamespace>
    <AssemblyName>Aisles</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\Aisles.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!-- One output path whether the project or the solution drives the build.
         Without this, Platform=AnyCPU produces bin\Debug and Platform=x64 produces
         bin\x64\Debug, which is exactly how a stale binary gets launched by mistake. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <None Update="consoles.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- The active app is pixel art. Keep the retired wood/3D workshop sources in
         the repository without copying them into builds or releases. -->
    <Content Include="wwwroot\**\*" Exclude="wwwroot\art\retail-wood-v1\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\Aisles.ico">
      <Link>wwwroot\branding\Aisles.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\png\aisles-64.png;..\..\assets\png\aisles-128.png">
      <Link>wwwroot\branding\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- The .NET publish target drops the generated WinUI resources even though
       they are present in TargetDir. An unpackaged build cannot load XAML
       without these files. -->
  <Target Name="CopyWinUiResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUiPublishResource Include="$(TargetDir)$(AssemblyName).pri" />
      <_WinUiPublishResource Include="$(TargetDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUiPublishResource)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
