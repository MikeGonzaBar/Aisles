# --- .NET build output ---
bin/
obj/
.vs/
*.user
*.suo
*.userprefs

# --- Node (asset + workshop tooling) ---
node_modules/
.cache/
.tmp-model-review/
.tmp-model-import/

# --- Raw downloaded console model sources (560 MB, one file at 176 MB) ---
# Reproducible via tools/ import + prepare scripts; assets/models/ holds the
# optimised runtime copies that the app actually ships.
3d models/

# --- Local runtime state ---
# Aisles' own metadata/artwork cache is machine-local, never a source artifact.
appdata/
# Never commit a linked RetroAchievements account or its web API key.
retroachievements.json

# --- Generated retrospective background sources ---
# Runtime copies live under src/Aisles.App/wwwroot/art/retail-wood-v1/.
artifacts/retroshelf-backgrounds/

# --- Build distribution directories (pipeline-generated) ---
artifacts/installer/*
artifacts/publish/*
artifacts/publish-fixed/*

# --- OS noise ---
Thumbs.db
desktop.ini
.DS_Store
